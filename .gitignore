# ================================
# Unity 6 / Unity 6000.x .gitignore
# ================================

# Core Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/

# New Unity 6+ User Settings folder
/[Uu]ser[Ss]ettings/

# Unity Cache Server / Artifacts
/[Ll]ibrary/Artifacts/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Ignore Asset Store tools if needed
# /[Aa]ssets/AssetStoreTools*

# JetBrains Rider plugin (auto-generated)
[Aa]ssets/Plugins/Editor/JetBrains*

# VS Code / JetBrains / Rider / VS settings
.vscode/
.idea/
.vs/
.gradle/

# Autogenerated solution/project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 6 Burst + DOTS
*.burst
*.burst.meta
[Bb]urstCache/

# Unity 6 Shader Cache
/[Ll]ibrary/ShaderCache/
/[Ll]ibrary/SourceAssetDB/

# Unity 6 Input System
/[Ll]ibrary/InputDeviceProfileCache/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.ipa
*.exe
*.app
*.xcodeproj
*.xcworkspace

# Crashlytics
crashlytics-build.properties

# Gradle
.gradle/
**/gradle.properties

# Android / iOS auto-generated
/[Aa]ndroid/
/[iI]OS/
*.keystore
*.jks

# Cloud Build artifacts
/[Bb]uildCloud/

# Rider package restore folder
/.idea/.fleet/


**.dwlt

