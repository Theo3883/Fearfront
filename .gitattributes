# Unity files should use LF line endings
*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.glslin text eol=lf

# Unity YAML files (text-based, safe to merge with unityyamlmerge)
*.meta text eol=lf
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.lighting text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf

# Unity binary assets — MUST be treated as binary (no text normalization/merging)
*.asset binary
*.mat binary
*.fbx binary
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.gif binary
*.psd binary
*.ai binary
*.cubemap binary

# Unity text-based assets
*.asmdef text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf

# Configuration files
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# UserSettings should stay as-is
UserSettings/** text eol=lf

